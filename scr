-- [port] Coordinator (user request): features that drive the character (item farm, stand
-- farms, quest/NPC farm, auto prestige) take turns instead of fighting over it. Each one calls
-- checkpoint() at safe points (the start of a loop iteration or of an action). With one
-- feature running, checkpoint() returns at once, so single-feature behaviour is the original's.
-- Turn changes are printed as "[Coordinator] ..." (mirrored to YBA/console_log.txt).
do
  local C = {
    enabled = L28_1("COORD", true) ~= false,
    slice = tonumber(L28_1("COORD_SLICE", 60)) or 60,
    holder = nil,         -- feature that may drive the character
    sliceStart = 0,
    waiting = {},         -- feature -> tick() when it started waiting
    active = {},          -- feature -> function: is the feature still switched on
    seen = {},            -- feature -> tick() of its latest checkpoint
    ready = {},           -- feature -> function: it has something to do now (absent: always)
    STALE = 120,          -- a holder silent this long while on is treated as stuck
    -- the quest farm and Auto Prestige's storyline share the game's single quest slot
    yieldsTo = {QuestFarm = "AutoPrestige"},
    -- while both run, the stand farm gets its arrows and Rokakaka from the item farm
    feeds = {StandFarm = "ItemFarm"},
    names = {
      ItemFarm = "Item Farm",
      StandFarm = "Stand Farm",
      QuestFarm = "Quest/NPC Farm",
      AutoPrestige = "Auto Prestige"
    }
  }
  getgenv()._YBA_Coord = C

  local function running(name)
    local f = C.active[name]
    if not f then
      return false
    end
    local ok, on = pcall(f)
    return ok and on and true or false
  end

  local function blocked(name)
    local other = C.yieldsTo[name]
    return other ~= nil and running(other)
  end

  -- the holder no longer needs the character: switched off, or stuck outside any checkpoint
  local function vacant(holder)
    return holder == nil or not running(holder) or tick() - (C.seen[holder] or 0) > C.STALE
  end

  local function ownReady(name)
    local f = C.ready[name]
    if not f then
      return true
    end
    local ok, r = pcall(f)
    return not ok or (r and true or false)   -- a failing check never starves a feature
  end

  -- a feature has something to do: by its own check, or a running feature it feeds waits on it
  local function ready(name)
    if ownReady(name) then
      return true
    end
    for other, source in pairs(C.feeds) do
      if source == name and running(other) and not ownReady(other) then
        return true
      end
    end
    return false
  end

  -- the feature that has waited longest and may run now, other than except; only ready ones
  -- unless anyState
  local function nextWaiter(except, anyState)
    local best, bestT
    for name, t in pairs(C.waiting) do
      if name ~= except and running(name) and not blocked(name) and (bestT == nil or t < bestT)
        and (anyState or ready(name)) then
        best, bestT = name, t
      end
    end
    return best
  end

  local function grant(name)
    if C.holder ~= name then
      print("[Coordinator] " .. tostring(C.names[C.holder] or "idle") .. " -> " .. tostring(C.names[name] or name))
    end
    C.holder = name
    C.sliceStart = tick()
    C.seen[name] = tick()
    C.waiting[name] = nil
  end

  -- name: feature id; isOn(): whether the feature is still switched on; idle: it has nothing to
  -- do right now (hand over at once if another feature waits); onPause(): stops the feature's own
  -- movement before another takes over; onWait(): called every 0.25 s while it waits;
  -- readyFn(): while it waits, whether it has something to do (a turn is only handed to a ready
  -- feature; when none is, the longest waiting one takes a vacant lease).
  -- Returns false when the feature is off or was switched off while waiting (the caller leaves
  -- its loop). An old session still looping after its toggle went off (Auto Prestige's storyline
  -- loop never checked) stops here instead of running forever.
  function C.checkpoint(name, isOn, idle, onPause, onWait, readyFn)
    local ok, on = pcall(isOn)
    if not (ok and on) then
      return false
    end
    if not C.enabled then
      return true
    end
    C.active[name] = isOn
    C.ready[name] = readyFn
    C.seen[name] = tick()
    local holder = C.holder
    if holder == name or vacant(holder) then
      if not blocked(name) then
        if holder ~= name then
          grant(name)
        end
        if not idle and tick() - C.sliceStart < C.slice then
          return true
        end
        local other = nextWaiter(name)
        if other == nil then
          return true
        end
        grant(other)
      elseif holder == name then
        -- blocked while holding (the feature it yields to has started): let others run
        C.holder = nil
        local other = nextWaiter(name)
        if other then
          grant(other)
        end
      end
    end
    if onPause then
      pcall(onPause)
    end
    C.waiting[name] = C.waiting[name] or tick()
    while true do
      task.wait(0.25)
      if not C.enabled then
        C.waiting[name] = nil
        return true
      end
      if not running(name) then
        C.waiting[name] = nil
        return false
      end
      if C.holder == name then
        C.seen[name] = tick()
        return true
      end
      if vacant(C.holder) and (nextWaiter(nil) or nextWaiter(nil, true)) == name then
        grant(name)
        return true
      end
      if onWait then
        pcall(onWait)
      end
    end
  end

  -- whether name may move the character now (for event handlers such as respawn teleports)
  function C.allows(name)
    return not C.enabled or C.holder == name or vacant(C.holder)
  end

  function C.setEnabled(on)
    C.enabled = on and true or false
    C.holder = nil
  end
end

-- [port] Low Render Mode (user request): 3D rendering off (RunService:Set3dRenderingEnabled) and a
-- dashboard instead, updated once a second: what is running, stand, items, money, recent
-- messages. It only reads the local player's data (no remote calls). The dashboard sits above
-- the game's HUD and below the hub (toggle button 50, MacLib window above), and takes no input,
-- so clicks the farms send to dialogue buttons still reach them.
do
  local D = {
    enabled = false,
    gen = 0,              -- update loop generation: one loop per enable
    activity = {},        -- recent notifications, newest last
    MAX_ACTIVITY = 8,
    gui = nil,
    labels = nil,
    startTime = 0,        -- session start (when the dashboard was switched on)
    startMoney = nil
  }
  getgenv()._YBA_Dashboard = D

  -- fed by the hub's notify function: every farm's status messages pass through it
  function D.log(title, text)
    local list = D.activity
    list[#list + 1] = os.date("%H:%M:%S") .. "  " .. tostring(title) .. ": " .. tostring(text)
    if #list > D.MAX_ACTIVITY then
      table.remove(list, 1)
    end
  end

  local function newLabel(parent, order, font, size, color)
    local t = Instance.new("TextLabel")
    t.BackgroundTransparency = 1
    t.Size = UDim2.new(1, 0, 0, 0)
    t.AutomaticSize = Enum.AutomaticSize.Y
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.TextYAlignment = Enum.TextYAlignment.Top
    t.TextWrapped = true
    t.Font = font
    t.TextSize = size
    t.TextColor3 = color or Color3.fromRGB(225, 225, 232)
    t.LayoutOrder = order
    t.Text = ""
    t.Parent = parent
    return t
  end

  -- full-screen background with a centred column of sections; returns the gui and its labels
  local function build()
    local gui = Instance.new("ScreenGui")
    gui.Name = "YBAThingDashboard"
    gui.ResetOnSpawn = false
    gui.IgnoreGuiInset = true
    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    gui.DisplayOrder = 40
    local bg = Instance.new("Frame")
    bg.Size = UDim2.fromScale(1, 1)
    bg.BackgroundColor3 = Color3.fromRGB(14, 14, 18)
    bg.BorderSizePixel = 0
    bg.Active = false
    bg.Parent = gui
    local panel = Instance.new("Frame")
    panel.AnchorPoint = Vector2.new(0.5, 0.5)
    panel.Position = UDim2.fromScale(0.5, 0.5)
    panel.Size = UDim2.new(0.9, 0, 0, 0)
    panel.AutomaticSize = Enum.AutomaticSize.Y
    panel.BackgroundTransparency = 1
    panel.Parent = bg
    local limit = Instance.new("UISizeConstraint")
    limit.MaxSize = Vector2.new(640, math.huge)
    limit.Parent = panel
    local list = Instance.new("UIListLayout")
    list.Padding = UDim.new(0, 10)
    list.SortOrder = Enum.SortOrder.LayoutOrder
    list.Parent = panel
    local title = newLabel(panel, 1, Enum.Font.GothamBold, 22, Color3.fromRGB(150, 180, 255))
    title.Text = "YBA Thing - Low Render Mode"
    local labels = {
      doing = newLabel(panel, 2, Enum.Font.Gotham, 17),
      player = newLabel(panel, 3, Enum.Font.Gotham, 17),
      stand = newLabel(panel, 4, Enum.Font.Gotham, 17),
      items = newLabel(panel, 5, Enum.Font.RobotoMono, 15),
      activity = newLabel(panel, 6, Enum.Font.RobotoMono, 13, Color3.fromRGB(160, 160, 170))
    }
    local ok = pcall(function()
      gui.Parent = gethui and gethui() or game:GetService("CoreGui")
    end)
    if not ok or not gui.Parent then
      pcall(function()
        gui.Parent = L2_1:FindFirstChild("PlayerGui")
      end)
    end
    local runtime = getgenv().__YBA_RUNTIME
    if type(runtime) == "table" and type(runtime.Guis) == "table" then
      runtime.Guis[#runtime.Guis + 1] = gui
    end
    return gui, labels
  end

  local function stat(ps, name)
    local v = ps and ps:FindFirstChild(name)
    return v and v.Value
  end

  -- 1234567 -> "1,234,567"
  local function money(n)
    local s = tostring(math.floor(math.abs(n)))
    s = s:reverse():gsub("(%d%d%d)", "%1,"):reverse():gsub("^,", "")
    return (n < 0 and "-" or "") .. s
  end

  local function duration(sec)
    sec = math.max(0, math.floor(sec))
    return string.format("%d:%02d:%02d", math.floor(sec / 3600), math.floor(sec / 60) % 60, sec % 60)
  end

  -- features on, from the coordinator (whose turn it is, who waits)
  local function doingText()
    local C = getgenv()._YBA_Coord
    if not C then
      return "Doing: -"
    end
    if not C.enabled then
      return "Doing: (Coordinate Farms is off, so turns are not tracked)"
    end
    local parts = {}
    for name, isOn in pairs(C.active) do
      local ok, on = pcall(isOn)
      if ok and on then
        local state = C.holder == name and "running" or C.waiting[name] and "waiting its turn" or "on"
        parts[#parts + 1] = (C.names[name] or name) .. " (" .. state .. ")"
      end
    end
    table.sort(parts)
    return "Doing: " .. (#parts > 0 and table.concat(parts, ", ") or "no farm running")
  end

  local function playerText(ps)
    local lines = {
      string.format("Prestige %s   Level %s", tostring(stat(ps, "Prestige") or "?"), tostring(stat(ps, "Level") or "?"))
    }
    local m = tonumber(stat(ps, "Money"))
    if m then
      D.startMoney = D.startMoney or m
      local gained = m - D.startMoney
      lines[#lines + 1] = "Money: $" .. money(m) .. "   (" .. (gained < 0 and "" or "+") .. money(gained) .. " this session)"
    end
    lines[#lines + 1] = "Session: " .. duration(tick() - D.startTime)
    return table.concat(lines, "\n")
  end

  -- the skin is the stand farm's latest check (no remote call here)
  local function standText(ps)
    local stand = tostring(stat(ps, "Stand") or "None")
    local s = "Stand: " .. stand
    local skin = getgenv()._YBA_LastSkin
    if skin and skin.stand == stand and skin.skin and skin.skin ~= "None" and skin.skin ~= "" then
      s = s .. "  [" .. tostring(skin.skin) .. "]"
    end
    local spec = stat(ps, "Spec")
    if spec and spec ~= "None" and spec ~= "" then
      s = s .. "\nSpec: " .. tostring(spec)
    end
    local st = getgenv()._YBA_SFStats
    if st and (st.standsGot or 0) > 0 then
      s = s .. string.format("\nStand farm (this server): %d stands, %d arrows, %d lucky arrows, %d Rokakaka",
        st.standsGot, st.arrowsUsed or 0, st.luckyArrowsUsed or 0, st.rokasUsed or 0)
    end
    return s
  end

  -- every Tool in the backpack and the character, counted by name, in two columns
  local function itemsText()
    local counts, names = {}, {}
    local boxes = {L2_1:FindFirstChild("Backpack"), L2_1.Character}
    for i = 1, 2 do
      local box = boxes[i]
      for _, tool in ipairs(box and box:GetChildren() or {}) do
        if tool:IsA("Tool") then
          local n = tool.Name
          if not counts[n] then
            names[#names + 1] = n
          end
          counts[n] = (counts[n] or 0) + 1
        end
      end
    end
    if #names == 0 then
      return "Items: none"
    end
    table.sort(names)
    local half = math.ceil(#names / 2)
    local lines = {"Items:"}
    for i = 1, half do
      local left = string.format("%3d %-31s", counts[names[i]], names[i])
      local right = names[i + half] and string.format("%3d %s", counts[names[i + half]], names[i + half]) or ""
      lines[#lines + 1] = left .. right
    end
    return table.concat(lines, "\n")
  end

  local function activityText()
    if #D.activity == 0 then
      return "Recent: (nothing yet)"
    end
    return "Recent:\n" .. table.concat(D.activity, "\n")
  end

  local function setText(label, text)
    if label.Text ~= text then
      label.Text = text
    end
  end

  local function update()
    local L = D.labels
    local ps = L2_1:FindFirstChild("PlayerStats")
